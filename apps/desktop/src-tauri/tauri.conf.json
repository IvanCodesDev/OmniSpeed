{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniSpeed",
  "version": "0.1.0",
  "identifier": "com.omnispeed.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniSpeed",
        "width": 1080,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "OmniSpeed —— 全局倍速播放遥控器",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3RDhFQjk3M0I1Q0UxNjYKUldSbTRWdzdsK3ZZbHpSbjhmUjJ4YXQ1KzlGV3A2UnpWL2ZXaTVXeWhwUEpuVU9TNThXUGEyWksK",
      "endpoints": [
        "https://github.com/IvanCodesDev/OmniSpeed/releases/latest/download/latest.json"
      ]
    }
  }
}
